<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="12dp"
    android:gravity="center_horizontal">

    <!-- ===== GAUGES ROW ===== -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center">

        <!-- RPM -->
        <FrameLayout
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_margin="6dp">

            <ProgressBar
                android:id="@+id/rpmGauge"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="8000"
                android:progress="0"
                android:indeterminate="false"
                android:rotation="-90"/>

            <TextView
                android:id="@+id/rpmText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="RPM\n0"
                android:textColor="#00FF00"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"/>
        </FrameLayout>

        <!-- SPEED -->
        <FrameLayout
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_margin="6dp">

            <ProgressBar
                android:id="@+id/speedGauge"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="240"
                android:progress="0"
                android:indeterminate="false"
                android:rotation="-90"/>

            <TextView
                android:id="@+id/speedText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="SPEED\n0"
                android:textColor="#00FF00"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"/>
        </FrameLayout>
    </LinearLayout>

    <!-- ===== BOOST ===== -->
    <FrameLayout
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginTop="8dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/gauge_boost_ticks"/>

        <ImageView
            android:id="@+id/boostNeedle"
            android:layout_width="3dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:src="@drawable/needle_boost"
            android:rotation="135"/>

        <TextView
            android:id="@+id/boostText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="BOOST\n0.00 bar"
            android:textColor="#FFFFFF"
            android:gravity="center|bottom"
            android:paddingBottom="18dp"/>
    </FrameLayout>

    <!-- ===== BUTTONS ===== -->
    <Button
        android:id="@+id/btnSelectElm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select ELM327"/>

    <Button
        android:id="@+id/btnReadDtc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Read DTC"/>

    <Button
        android:id="@+id/btnClearDtc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Clear DTC"/>

</LinearLayout>
