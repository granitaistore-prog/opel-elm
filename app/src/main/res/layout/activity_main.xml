<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:gravity="center_horizontal">

    <!-- GAUGES -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center">

        <!-- RPM GAUGE -->
        <FrameLayout
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_margin="8dp">

            <!-- Gauge -->
            <ProgressBar
                android:id="@+id/rpmGauge"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="8000"
                android:progress="0"
                android:indeterminate="false"
                android:progressDrawable="@drawable/gauge_rpm"
                android:rotation="-90"/>

            <!-- Needle -->
            <ImageView
                android:id="@+id/rpmNeedle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/needle"
                android:layout_gravity="center"
                android:pivotX="50%"
                android:pivotY="100%"
                android:rotation="-135"/>

            <!-- Text -->
            <TextView
                android:id="@+id/rpm"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="RPM\n0"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"/>
        </FrameLayout>

        <!-- SPEED GAUGE -->
        <FrameLayout
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_margin="8dp">

            <!-- Gauge -->
            <ProgressBar
                android:id="@+id/speedGauge"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="240"
                android:progress="0"
                android:indeterminate="false"
                android:progressDrawable="@drawable/gauge_speed"
                android:rotation="-90"/>

            <!-- Needle -->
            <ImageView
                android:id="@+id/speedNeedle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/needle"
                android:layout_gravity="center"
                android:pivotX="50%"
                android:pivotY="100%"
                android:rotation="-135"/>

            <!-- Text -->
            <TextView
                android:id="@+id/speed"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="SPEED\n0"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"/>
        </FrameLayout>

    </LinearLayout>

    <!-- BUTTONS -->
    <Button
        android:id="@+id/btnSelectElm"
        android:text="Select ELM327"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/btnReadDtc"
        android:text="Read DTC"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/btnClearDtc"
        android:text="Clear DTC"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

</LinearLayout>
